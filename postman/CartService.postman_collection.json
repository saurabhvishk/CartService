{
  "info": {
    "name": "Cart Service (PRD 3.1, 3.2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order: 1 Setup, 2 Cart. Needs User Auth (9000), Product Catalog (8080) and Cart (8081) running."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "authUrl",
      "value": "localhost:9000"
    },
    {
      "key": "productUrl",
      "value": "localhost:8080"
    },
    {
      "key": "cartUrl",
      "value": "localhost:8081"
    },
    {
      "key": "email",
      "value": "cart-user@test.com"
    },
    {
      "key": "password",
      "value": "pass1234"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Setup",
      "item": [
        {
          "name": "Create product 1 (iPhone)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/products",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Product Catalog needs an explicit id until @GeneratedValue is added.",
            "body": {
              "mode": "raw",
              "raw": "{\"id\": 1, \"name\": \"iPhone\", \"description\": \"phone\", \"price\": 999.0, \"imageUrl\": \"x\", \"category\": {\"id\": 1, \"name\": \"Phones\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create product 2 (Case)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/products",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"id\": 2, \"name\": \"Case\", \"description\": \"case\", \"price\": 19.99, \"imageUrl\": \"x\", \"category\": {\"id\": 1, \"name\": \"Phones\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Signup (409 is fine if user exists)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/auth/signup",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.cookies.get(\"auth-token\"));",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().id);",
                  "console.log(\"token saved for user \" + pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Cart",
      "item": [
        {
          "name": "1 View cart (empty at first)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{cartUrl}}/carts/me",
              "host": [
                "{{cartUrl}}"
              ],
              "path": [
                "carts",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Add iPhone x1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cartUrl}}/carts/me/items",
              "host": [
                "{{cartUrl}}"
              ],
              "path": [
                "carts",
                "me",
                "items"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"productId\": 1, \"quantity\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3 Add Case x3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cartUrl}}/carts/me/items",
              "host": [
                "{{cartUrl}}"
              ],
              "path": [
                "carts",
                "me",
                "items"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"productId\": 2, \"quantity\": 3}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"case line total 59.97\", () => pm.expect(pm.response.json().items.find(i => i.productId === 2).lineTotal).to.eql(59.97));"
                ]
              }
            }
          ]
        },
        {
          "name": "4 Add iPhone x2 again (same line)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cartUrl}}/carts/me/items",
              "host": [
                "{{cartUrl}}"
              ],
              "path": [
                "carts",
                "me",
                "items"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"productId\": 1, \"quantity\": 2}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"still one iPhone line, quantity 3\", () => { const l = pm.response.json().items.filter(i => i.productId === 1); pm.expect(l.length).to.eql(1); pm.expect(l[0].quantity).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5 View cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{cartUrl}}/carts/me",
              "host": [
                "{{cartUrl}}"
              ],
              "path": [
                "carts",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "6 Unknown product -> 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cartUrl}}/carts/me/items",
              "host": [
                "{{cartUrl}}"
              ],
              "path": [
                "carts",
                "me",
                "items"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"productId\": 999, \"quantity\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "7 Quantity 0 -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cartUrl}}/carts/me/items",
              "host": [
                "{{cartUrl}}"
              ],
              "path": [
                "carts",
                "me",
                "items"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"productId\": 1, \"quantity\": 0}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "8 Missing fields -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cartUrl}}/carts/me/items",
              "host": [
                "{{cartUrl}}"
              ],
              "path": [
                "carts",
                "me",
                "items"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "9 Invalid token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{cartUrl}}/carts/me",
              "host": [
                "{{cartUrl}}"
              ],
              "path": [
                "carts",
                "me"
              ]
            },
            "description": "Uses a fake Bearer token. Postman also sends the auth-token cookie, but the Bearer header is checked first, so the fake one is used.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-real-token",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}